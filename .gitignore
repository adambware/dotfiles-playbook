# .gitignore for macOS setup playbook

# macOS system files
.DS_Store
.AppleDouble
.LSOverride

# Icon must end with two \r
Icon

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Private configuration files
roles/adambware.private/files/
roles/adambware.private/templates/
roles/adambware.private/vars/*.yml
!roles/adambware.private/vars/main.yml.example

# Ansible retry files
*.retry

# Ansible Galaxy installation files
*.tar.gz

# Python
__pycache__/
*.py[cod]
*$py.class
.python-version
*.so
.env
.venv
env/
venv/
ENV/

# Editor files
.idea/
.vscode/
*.swp
*.swo
*~

# Backup files
*.bak
*.old
*.orig
*.new
*.backup
*.save

# Logs
logs/
*.log

# Test results (if not using default ~/dotfiles-test-results location)
test-results/
*_results.*/

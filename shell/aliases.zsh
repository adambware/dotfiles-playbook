#
# Aliases
#

# Safety
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

# Listing
alias lsa='ls -lah'
alias l='ls -lah'
alias ll='ls -lh'
alias la='ls -lAh'

# Utilities
alias df='df -h'
alias du='du -h -c'
alias mkdir='mkdir -p -v'
alias cd..='cd ..'
alias ..='cd ..'
alias ping='ping -c 5'
alias more='less'

# Quick edits
alias viz='vi ~/.zshrc'
alias vioz='vi ~/.oh-my-zsh/oh-my-zsh.sh'
alias viozt='vi ~/.oh-my-zsh/custom/adambware.zsh-theme'

# Misc
alias java='/Library/Internet\ Plug-Ins/JavaAppletPlugin.plugin/Contents/Home/bin/java'
alias reload!='. ~/.zshrc'

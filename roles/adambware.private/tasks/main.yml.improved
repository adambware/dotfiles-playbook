---
# tasks file for adambware.private

# Homebrew packages and casks
- name: Install private Homebrew packages
  community.general.homebrew:
    name: "{{ item }}"
    state: present
  with_items: "{{ private_brew_packages | default([]) }}"
  when: private_brew_packages is defined

- name: Install private Homebrew casks
  community.general.homebrew_cask:
    name: "{{ item }}"
    state: present
    install_options: "appdir=/Applications"
  with_items: "{{ private_brew_casks | default([]) }}"
  when: private_brew_casks is defined

# SSH and configuration directories
- name: Ensure configuration directories exist
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    mode: '0700'
  with_items:
    - "{{ ansible_env.HOME }}/.ssh"
    - "{{ ansible_env.HOME }}/.aws"
    - "{{ ansible_env.HOME }}/.config"
    - "{{ ansible_env.HOME }}/Library/Application Support/Code/User"

# Copy configuration files
- name: Copy private SSH keys
  ansible.builtin.copy:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    mode: "{{ item.mode }}"
  with_items: "{{ private_ssh_keys | default([]) }}"
  when: private_ssh_keys is defined

- name: Copy private configuration files
  ansible.builtin.copy:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    mode: "{{ item.mode }}"
  with_items: "{{ private_config_files | default([]) }}"
  when: private_config_files is defined

# Git configuration
- name: Configure Git settings
  ansible.builtin.git_config:
    name: "{{ item.key }}"
    value: "{{ item.value }}"
    scope: global
  with_dict: "{{ private_git_config | default({}) }}"
  when: private_git_config is defined

# Shell configuration
- name: Add private environment variables to shell config
  ansible.builtin.blockinfile:
    path: "{{ ansible_env.HOME }}/.zshrc"
    marker: "# {mark} PRIVATE ENVIRONMENT VARIABLES"
    block: "{{ private_env_vars | join('\n') }}"
    create: yes
  when: private_env_vars is defined and private_env_vars | length > 0

- name: Add private shell aliases to shell config
  ansible.builtin.blockinfile:
    path: "{{ ansible_env.HOME }}/.zshrc"
    marker: "# {mark} PRIVATE SHELL ALIASES"
    block: "{{ private_shell_aliases | join('\n') }}"
    create: yes
  when: private_shell_aliases is defined and private_shell_aliases | length > 0

# VS Code extensions
- name: Install VS Code extensions
  ansible.builtin.command: "code --install-extension {{ item }}"
  with_items: "{{ private_vscode_extensions | default([]) }}"
  when: private_vscode_extensions is defined
  register: vscode_extension_result
  changed_when: "'already installed' not in vscode_extension_result.stdout"
  failed_when: false

# VPN configurations
- name: Ensure VPN configuration directories exist
  ansible.builtin.file:
    path: "{{ ansible_env.HOME }}/.config/vpn"
    state: directory
    mode: '0700'
  when: private_vpn_configs is defined

- name: Set up VPN configurations
  ansible.builtin.include_tasks: vpn_setup.yml
  when: private_vpn_configs is defined

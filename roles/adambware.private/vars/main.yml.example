---
# Comprehensive example variables file for the private role
# Copy this to main.yml and customize for your personal configurations

# Private Homebrew packages to install
private_brew_packages:
  - awscli                  # AWS Command Line Interface
  - azure-cli               # Microsoft Azure CLI
  - kubernetes-cli          # Kubernetes CLI (kubectl)
  - terraform               # Infrastructure as Code tool
  - vault                   # Secrets management
  - gh                      # GitHub CLI
  - jq                      # JSON processor

# Private Homebrew casks to install
private_brew_casks:
  - docker                  # Containerization platform
  - slack                   # Team communication
  - zoom                    # Video conferencing
  - 1password               # Password manager
  - notion                  # Notes and project management
  - postman                 # API testing tool
  - jetbrains-toolbox       # JetBrains IDEs manager

# Private configuration files to copy
private_config_files:
  - src: "files/aws/config"
    dest: "{{ ansible_env.HOME }}/.aws/config"
    mode: "0644"
  - src: "files/aws/credentials"
    dest: "{{ ansible_env.HOME }}/.aws/credentials"
    mode: "0600"
  - src: "files/vscode/settings.json"
    dest: "{{ ansible_env.HOME }}/Library/Application Support/Code/User/settings.json"
    mode: "0644"
  - src: "files/vscode/keybindings.json"
    dest: "{{ ansible_env.HOME }}/Library/Application Support/Code/User/keybindings.json"
    mode: "0644"
  - src: "files/intellij/idea.properties"
    dest: "{{ ansible_env.HOME }}/Library/Application Support/JetBrains/IntelliJIdea2023.1/idea.properties"
    mode: "0644"

# Private SSH keys to copy
private_ssh_keys:
  - src: "files/ssh/id_rsa"
    dest: "{{ ansible_env.HOME }}/.ssh/id_rsa"
    mode: "0600"
  - src: "files/ssh/id_rsa.pub"
    dest: "{{ ansible_env.HOME }}/.ssh/id_rsa.pub"
    mode: "0644"
  - src: "files/ssh/id_ed25519"
    dest: "{{ ansible_env.HOME }}/.ssh/id_ed25519"
    mode: "0600"
  - src: "files/ssh/id_ed25519.pub"
    dest: "{{ ansible_env.HOME }}/.ssh/id_ed25519.pub"
    mode: "0644"
  - src: "files/ssh/config"
    dest: "{{ ansible_env.HOME }}/.ssh/config"
    mode: "0644"

# Private git configuration
private_git_config:
  user.name: "Your Name"
  user.email: "your.email@example.com"
  github.user: "yourusername"
  core.editor: "code --wait"
  pull.rebase: "true"
  init.defaultBranch: "main"
  push.autoSetupRemote: "true"
  core.excludesfile: "{{ ansible_env.HOME }}/.gitignore_global"

# Private shell aliases
private_shell_aliases:
  - "alias dc='docker-compose'"
  - "alias k='kubectl'"
  - "alias tf='terraform'"
  - "alias aws-login='aws sso login --profile default'"
